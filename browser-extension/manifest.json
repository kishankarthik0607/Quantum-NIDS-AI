{
  "manifest_version": 3,
  "name": "Quantum NIDS Browser Guard",
  "version": "1.0",
  "description": "Monitors browser-visible security indicators using the Quantum NIDS ML engine.",
  "permissions": [
    "cookies",
    "webRequest",
    "storage",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Quantum NIDS Guard"
  },
  "options_page": "options/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
